{
	"name": "pi-free",
	"version": "2.7.1",
	"description": "AI model providers for Pi with free model filtering and dynamic model fetching",
	"keywords": [
		"cline",
		"crofai",
		"free-models",
		"kilo",
		"model-filter",
		"nvidia-nim",
		"ollama-cloud",
		"paid-models",
		"pi-extension",
		"pi-package",
		"zenmux"
	],
	"homepage": "https://github.com/apmantza/pi-free#readme",
	"bugs": {
		"url": "https://github.com/apmantza/pi-free/issues"
	},
	"license": "MIT",
	"author": "Apostolos Mantzaris",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/apmantza/pi-free.git"
	},
	"files": [
		"dist/**/*",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"banner.svg",
		"scripts/check-extensions.mjs",
		"scripts/pi-install-smoke.mjs",
		"scripts/rpc-load-check.mjs",
		"scripts/lib/rpc-driver.mjs"
	],
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"audit:prod": "npm audit --omit=dev --omit=peer --audit-level=high",
		"build": "node scripts/build.mjs",
		"clean": "node scripts/clean.mjs",
		"check": "node scripts/check-extensions.mjs",
		"check:lockfile": "node scripts/check-lockfile-sync.mjs",
		"check:runtime-imports": "node scripts/check-runtime-imports.mjs",
		"check:tarball": "node scripts/check-tarball.mjs",
		"check:prod-install-shape": "node scripts/check-prod-install-shape.mjs",
		"check:closure": "node scripts/check-installed-closure.mjs",
		"check:hoisting": "node scripts/check-hoisting.mjs",
		"lint": "tsc --noEmit",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint:oxlint": "oxlint",
		"check:knip": "knip",
		"prepare": "npm run build",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"drive": "tsx scripts/drive-pi-ai.ts",
		"smoke:auto-fallback": "tsx scripts/smoke-auto-fallback.ts",
		"test:run": "vitest run",
		"bench:startup": "tsx scripts/bench-startup.ts",
		"mutation:diff": "tsx scripts/stryker-diff.ts --base origin/master --max-files 6",
		"smoke:compiled": "node scripts/smoke-compiled.mjs",
		"smoke:pi-loader": "node scripts/smoke-pi-loader.mjs",
		"smoke:pi-ai-entries": "node scripts/smoke-pi-ai-entries.mjs",
		"smoke:pi-install": "node scripts/pi-install-smoke.mjs",
		"smoke:pi-upgrade": "node scripts/pi-upgrade-smoke.mjs"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.84.4",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"esbuild": "^0.28.1",
		"knip": "6.35.0",
		"oxfmt": "0.67.0",
		"oxlint": "1.82.0",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.81.0",
		"@earendil-works/pi-coding-agent": ">=0.81.0",
		"@earendil-works/pi-tui": ">=0.81.0"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"overrides": {
		"@earendil-works/pi-coding-agent": {
			"brace-expansion": "^5.0.9",
			"minimatch": {
				"brace-expansion": "^5.0.9"
			}
		},
		"brace-expansion": "^5.0.9",
		"protobufjs": "^7.6.5"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.84.4",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"esbuild": "^0.28.1",
		"knip": "6.35.0",
		"oxfmt": "0.67.0",
		"oxlint": "1.82.0",
		"publint": "0.3.24",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	}
}
